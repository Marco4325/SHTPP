{
	"name": "TPP",
	"patterns": [
		{
			"include": "#constants"
		},
		{
			"include": "#entities"
		},
		{
			"include": "#storage"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"constants": {
			"patterns": [{
				"name": "constant.character.tpp",
				"match": "\\b([0-9]+\\.?[0-9]*([eE][+\\-]?)?[0-9]*)"
			}]
		},
		"entities": {
			"patterns": [{
				"name": "entity.name.function.tpp",
				"match": "\\b[a-zA-Z][a-zA-Z0-9]+\\(\\)"
			}]
		},
		"storage": {
			"patterns": [{
				"name": "storage.type.tpp",
				"match": "\\b(inteiro|flutuante)\\b"
			}]
		},
		"comments": {
			"patterns": [{
				"name": "comment.block.tpp",
				"begin": "\\{",
				"end": "\\}"
			}]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.tpp",
					"match": "\\b(se|então|fim|repita|até|retorna|leia|escreva)\\b"
				},
				{
					"name": "keyword.operator.tpp",
					"match": "[,:<>!=+\\-*/]|\\|\\||\\&\\&"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.tpp",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.tpp",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.tpp"
}